<Project Sdk="Microsoft.NET.Sdk">

    <!-- Unit tests for the pure (game and Steam independent) part of the Steam bridge and of some
         gameplay rules (enemy health scaling, arena entry). The sources are compiled
         directly into this assembly, so no game assemblies are needed. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Hkmp.SteamBridge.Tests</RootNamespace>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <HkmpSrc>..\..\src\HKMP</HkmpSrc>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="$(HkmpSrc)\Logging\ILogger.cs" Link="Linked\ILogger.cs" />
        <Compile Include="$(HkmpSrc)\Logging\Logger.cs" Link="Linked\Logger.cs" />
        <Compile Include="$(HkmpSrc)\Networking\SteamBridge\SteamJoinCode.cs" Link="Linked\SteamJoinCode.cs" />
        <Compile Include="$(HkmpSrc)\Networking\SteamBridge\SteamBridgeProtocol.cs" Link="Linked\SteamBridgeProtocol.cs" />
        <Compile Include="$(HkmpSrc)\Networking\SteamBridge\ISteamBridgeLink.cs" Link="Linked\ISteamBridgeLink.cs" />
        <Compile Include="$(HkmpSrc)\Networking\SteamBridge\SteamBridgeHostCore.cs" Link="Linked\SteamBridgeHostCore.cs" />
        <Compile Include="$(HkmpSrc)\Networking\SteamBridge\SteamBridgeClientCore.cs" Link="Linked\SteamBridgeClientCore.cs" />
        <Compile Include="$(HkmpSrc)\Networking\SteamBridge\SteamBridgeWorker.cs" Link="Linked\SteamBridgeWorker.cs" />
        <Compile Include="$(HkmpSrc)\Networking\SteamBridge\SteamBridgeSleep.cs" Link="Linked\SteamBridgeSleep.cs" />
        <!-- Pure gameplay logic (enemy health scaling, arena entry rules) -->
        <Compile Include="$(HkmpSrc)\Game\Client\Entity\EnemyHealthScaling.cs" Link="Linked\EnemyHealthScaling.cs" />
        <Compile Include="$(HkmpSrc)\Game\Client\Entity\EnemyTargetSelector.cs" Link="Linked\EnemyTargetSelector.cs" />
        <Compile Include="$(HkmpSrc)\Game\Client\Entity\GenericEnemyRules.cs" Link="Linked\GenericEnemyRules.cs" />
        <Compile Include="$(HkmpSrc)\Game\Client\Entity\EntityActivationRules.cs" Link="Linked\EntityActivationRules.cs" />
        <Compile Include="$(HkmpSrc)\Game\Client\ArenaEntryRules.cs" Link="Linked\ArenaEntryRules.cs" />
        <Compile Include="$(HkmpSrc)\Game\Client\TeleportTargetSelector.cs" Link="Linked\TeleportTargetSelector.cs" />
        <Compile Include="$(HkmpSrc)\Game\Client\TeleportRules.cs" Link="Linked\TeleportRules.cs" />
        <Compile Include="$(HkmpSrc)\Game\Client\Save\SharedProgressRules.cs" Link="Linked\SharedProgressRules.cs" />
        <Compile Include="$(HkmpSrc)\Game\Client\Save\GrubJarRules.cs" Link="Linked\GrubJarRules.cs" />
        <Compile Include="$(HkmpSrc)\Game\Client\Save\AbilityGateRules.cs" Link="Linked\AbilityGateRules.cs" />
        <Compile Include="$(HkmpSrc)\Util\SafeFile.cs" Link="Linked\SafeFile.cs" />
        <Compile Include="$(HkmpSrc)\Util\SaveFileFormat.cs" Link="Linked\SaveFileFormat.cs" />
        <Compile Include="$(HkmpSrc)\Util\UsernameRules.cs" Link="Linked\UsernameRules.cs" />
        <None Include="$(HkmpSrc)\Resource\save-data.json" Link="save-data.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    </ItemGroup>

</Project>
