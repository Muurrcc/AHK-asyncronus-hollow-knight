    <!-- Create an item group for the source and destination files of the copy target. This way we can specify
       multiple paths that we want the assembly to be copied to. -->
    <ItemGroup>
        <SourceFiles Include="$(TargetDir)*.dll;$(TargetDir)*.pdb;$(TargetDir)*.xml" />
        <Dest Include="$(OutputDirectory)" />
    </ItemGroup>
    <!-- Unity 6 assemblies are built against netstandard 2.1 but the net472 reference pack brings the 2.0 facade
         (CS1705), and Unity 6 APIs expose ReadOnlySpan<T> overloads (e.g. ImageConversion.LoadImage) that the
         net472 mscorlib lacks (CS0518). The Unity 6 BCL also moved types between assemblies (e.g. Queue<T> lives in
         mscorlib, CS0433 if mixed with the reference-pack System.dll). So every framework reference that also exists
         in the game's Managed folder is swapped for the game's (Unity Mono BCL) copy right before compiling. -->
    <PropertyGroup>
        <_HkmpRefsFull>$([System.IO.Path]::GetFullPath('$(References)'))</_HkmpRefsFull>
    </PropertyGroup>
    <Target Name="UseGameCoreLibs" AfterTargets="FindReferenceAssembliesForReferences" BeforeTargets="CoreCompile">
        <ItemGroup>
            <_HkmpSwap Include="@(ReferencePathWithRefAssemblies)" Condition="'%(Filename)' == 'netstandard' and Exists('$(References)\%(Filename).dll') and !$([System.String]::Copy('%(FullPath)').StartsWith('$(_HkmpRefsFull)', StringComparison.OrdinalIgnoreCase))" />
            <ReferencePathWithRefAssemblies Remove="@(_HkmpSwap)" />
            <ReferencePathWithRefAssemblies Include="@(_HkmpSwap->'$(_HkmpRefsFull)\%(Filename).dll')" />
        </ItemGroup>
    </Target>
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Copy SourceFiles="@(SourceFiles)" DestinationFolder="%(Dest.FullPath)" />
    </Target>
</Project>
