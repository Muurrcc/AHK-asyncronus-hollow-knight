<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="LocalBuildProperties_example.props" Condition="!Exists('LocalBuildProperties.props')" />
    <Import Project="LocalBuildProperties.props" Condition="Exists('LocalBuildProperties.props')" />

    <PropertyGroup>
        <ProjectGuid>{F34118B2-515D-4C33-88E6-9CFEF2AD5A15}</ProjectGuid>
        <RootNamespace>Hkmp</RootNamespace>
        <AssemblyName>HKMP</AssemblyName>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <TargetFramework>net472</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <LangVersion>latest</LangVersion>
        <!--Shortens and anonymizes paths in debug symbols relative to the project directory. Breakpoints will not work, however.-->
        <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=source</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HkmpServer" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Ui\Resources\Images\*.png" />
        <EmbeddedResource Include="Ui\Resources\Images\*.dat" />
        <EmbeddedResource Include="Resource\entity-registry.json" />
        <EmbeddedResource Include="Resource\action-registry.json" />
        <EmbeddedResource Include="Resource\save-data.json" />
        <EmbeddedResource Include="Resource\save-data-godseeker.json" />
        <EmbeddedResource Include="Resource\string-data.json" />
        <EmbeddedResource Include="Resource\music-data.json" />
    </ItemGroup>

